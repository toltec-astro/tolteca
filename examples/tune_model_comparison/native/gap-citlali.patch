+            const auto end=t;
+            const auto left=begin>0 ? begin-1 : good.front();
+            const auto right=end<n ? end : good.back();
+            for(auto s=begin;s<end;++s) {
+                const double f=left==right ? 0. : std::clamp(double(s-left)/(right-left),0.,1.);
+                const double baseline=(1-f)*source(left,c)+f*source(right,c);
+                double common=0.; int count=0;
+                for(Eigen::Index d=0;d<nd;++d) {
+                    if(d==c || apt_flags(d)!=0 || flags(s,d) || flags(left,d) || flags(right,d)) continue;
+                    const double rd=std::isfinite(response(d)) && response(d)!=0 ? response(d) : 1.;
+                    common+=(source(s,d)-(1-f)*source(left,d)-f*source(right,d))*rc/rd;
+                    ++count;
+                }
+                data(s,c)=baseline+(count ? common/count : 0.)+sigma*noise(rng);
+            }
+        }
+    }
+}
+
+/// Every filter output touched by a rejected input remains rejected for maps.
+template<class Flags>
+void expand_filter_mask(Flags &flags, Eigen::Index radius) {
+    const Flags original=flags;
+    for(Eigen::Index c=0;c<flags.cols();++c) {
+        Eigen::Index count=0;
+        for(Eigen::Index t=0;t<flags.rows();++t) {
+            if(t==0) for(Eigen::Index j=0;j<=std::min(radius,flags.rows()-1);++j) count+=original(j,c);
+            else {
+                if(t-radius-1>=0) count-=original(t-radius-1,c);
+                if(t+radius<flags.rows()) count+=original(t+radius,c);
+            }
+            flags(t,c)=count>0;
+        }
+    }
+}
