+using Flags=Eigen::Matrix<bool,Eigen::Dynamic,Eigen::Dynamic>;
+TEST(Gaps, FillPreservesMaskAndMeasurementsIsDeterministicAndHandlesEdges) {
+    Eigen::MatrixXd x(20,4);
+    for(int t=0;t<20;++t) for(int d=0;d<4;++d) x(t,d)=10+d+.1*t;
+    Flags f=Flags::Zero(20,4);
+    f.block(0,0,3,1).setOnes(); f.block(6,1,5,1).setOnes();
+    f.block(17,2,3,1).setOnes(); f.col(3).setOnes();
+    auto original=x; auto mask=f;
+    x=f.select(Eigen::MatrixXd::Constant(20,4,1e30),x);
+    auto y=x;
+    Eigen::VectorXd response=Eigen::VectorXd::Ones(4),apt=Eigen::VectorXd::Zero(4);
+    timestream::fill_gaps(x,f,response,apt,42);
+    timestream::fill_gaps(y,f,response,apt,42);
+    EXPECT_TRUE((f.array()==mask.array()).all()); EXPECT_EQ(x,y);
+    EXPECT_TRUE(x.allFinite()); EXPECT_LT(x.cwiseAbs().maxCoeff(),100.);
+    for(int t=0;t<20;++t) for(int d=0;d<4;++d) if(!f(t,d)) EXPECT_EQ(x(t,d),original(t,d));
+    EXPECT_TRUE(x.col(3).isZero());
+}
+
+TEST(Gaps, FilterSupportIsExcludedAndUnrelatedSamplesAreUnchanged) {
+    Eigen::MatrixXd a(30,1),b;
+    for(int t=0;t<30;++t) a(t,0)=std::sin(.3*t);
+    b=a; b(15,0)=500.;
+    timestream::Filter filter{}; filter.n_terms=2;
+    filter.filter=Eigen::VectorXd::Constant(5,.2);
+    filter.convolve(a); filter.convolve(b);
+    Flags flags=Flags::Zero(30,1); flags(15,0)=true;
+    timestream::expand_filter_mask(flags,2);
+    EXPECT_EQ(flags.count(),5);
+    for(int t=0;t<30;++t) if(!flags(t,0)) EXPECT_EQ(a(t,0),b(t,0));
+}
+
+TEST(Gaps, PcaIgnoresFilledValuesAndReportsInsufficientSupport) {
+    if(!spdlog::get("citlali_logger")) spdlog::stdout_color_mt("citlali_logger");
+    Eigen::MatrixXd x(5,3); x<<1,1,1,2,2,2,3,3,3,4,4,4,5,5,5;
+    Flags f=Flags::Zero(5,3); f(2,0)=true; f.row(4).setOnes();
+    Eigen::MatrixXd basis=Eigen::MatrixXd::Constant(3,1,1/std::sqrt(3.));
+    Eigen::VectorXd values=Eigen::VectorXd::Ones(1);
+    Eigen::MatrixXd a=x,b=x; b(2,0)=1e20;
+    timestream::Cleaner cleaner{}; cleaner.stddev_limit=0;
+    auto rejected=cleaner.remove_eig_values<timestream::Cleaner::EigenBackend>(x,f,values,basis,a,1);
+    cleaner.remove_eig_values<timestream::Cleaner::EigenBackend>(b,f,values,basis,b,1);
+    EXPECT_TRUE(rejected(4)); EXPECT_EQ(rejected.count(),1);
+    EXPECT_NEAR(a(2,1),0.,1e-12); EXPECT_NEAR(b(2,1),a(2,1),1e-12);
+    EXPECT_NEAR(a(2,2),0.,1e-12); EXPECT_NEAR(b(2,2),a(2,2),1e-12);
+}
