+    for(int d=0;d<nd;++d) {map.signal.push_back(Eigen::MatrixXd::Zero(3,3));map.weight.push_back(Eigen::MatrixXd::Zero(3,3));map.coverage.push_back(Eigen::MatrixXd::Zero(3,3));}
