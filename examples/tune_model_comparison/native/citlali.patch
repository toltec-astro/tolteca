+/// Pairwise covariance of already centered samples. Fewer than two shared
+/// valid samples provide no covariance estimate; keep that matrix entry zero.
+/// The PTC caller rejects entire channels with fewer than two valid samples.
+template <typename DerivedA, typename DerivedB, typename DerivedC>
+Eigen::MatrixXd masked_covariance(const Eigen::DenseBase<DerivedA> &scans,
+                                 const Eigen::DenseBase<DerivedB> &flags,
+                                 const Eigen::DenseBase<DerivedC> &apt_flags) {
+    Eigen::MatrixXd valid = (!flags.derived().array()).template cast<double>();
+    for (Eigen::Index i=0; i<scans.cols(); ++i)
+        if (apt_flags.derived()(i)!=0) valid.col(i).setZero();
+    // Select rather than multiply: a masked NaN must not contaminate neighbors.
+    Eigen::MatrixXd samples = (valid.array()!=0).select(scans.derived(), 0.);
+    if (!samples.allFinite())
+        throw std::runtime_error("PCA received an unflagged nonfinite sample");
+    Eigen::MatrixXd counts = valid.adjoint() * valid;
+    Eigen::MatrixXd cov = samples.adjoint() * samples;
+    for (Eigen::Index i=0; i<cov.size(); ++i)
+        cov(i) = counts(i)>=2 ? cov(i)/(counts(i)-1) : 0.;
+    return cov;
+}
 
