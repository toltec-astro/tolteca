+#include <citlali/core/engine/kidsproc.h>
+#include <citlali/core/timestream/ptc/ptcproc.h>
+#include <gtest/gtest.h>
+#include <spdlog/sinks/stdout_color_sinks.h>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+using Flags = Eigen::Matrix<bool,Eigen::Dynamic,Eigen::Dynamic>;
+TEST(Cleaner, PreservesOrdinaryCovarianceAndRejectsUnsupportedPairs) {
+    Eigen::MatrixXd scans(4,3); scans << 1,2,4, 2,4,3, 3,6,2, 4,8,1;
+    Flags flags=Flags::Zero(4,3);
+    Eigen::VectorXd apt=Eigen::VectorXd::Zero(3);
+    auto ordinary=timestream::masked_covariance(scans,flags,apt);
+    EXPECT_TRUE(ordinary.isApprox(scans.transpose()*scans/3.,0.));
+    // Two valid samples per channel, but only one shared sample.
+    flags.col(0)<<false,false,true,true;
+    flags.col(1)<<true,false,false,true;
+    auto partial=timestream::masked_covariance(scans,flags,apt);
+    EXPECT_EQ(partial(0,1),0.);
+    EXPECT_EQ(partial(1,0),0.);
+    EXPECT_EQ(partial(0,0),5.);
+    EXPECT_EQ(partial(1,1),52.);
+    scans(2,0)=std::numeric_limits<double>::quiet_NaN();
+    EXPECT_TRUE(timestream::masked_covariance(scans,flags,apt).allFinite());
+    flags(2,0)=false;
+    EXPECT_THROW(timestream::masked_covariance(scans,flags,apt),std::runtime_error);
+    apt(0)=1.;
+    EXPECT_TRUE(timestream::masked_covariance(scans,flags,apt).row(0).isZero());
+}
+
+TEST(Cleaner, SingleSampleChannelGetsNoMapContribution) {
+    if (!spdlog::get("citlali_logger")) spdlog::stdout_color_mt("citlali_logger");
+    timestream::PTCProc proc{}; proc.run_clean=false;
+    timestream::TCData<timestream::TCDataKind::PTC,Eigen::MatrixXd> data{};
+    data.scans.data=Eigen::MatrixXd::Random(4,3);
+    data.flags.data=Flags::Ones(4,3);
+    data.flags.data(1,0)=false;
+    data.flags.data.col(1).setZero();
+    engine::Calib calib{};
+    proc.run(data,data,calib,"altaz","array");
+    EXPECT_TRUE(data.flags.data.col(0).all());
+    EXPECT_TRUE((!data.flags.data.col(1).array()).all());
+    EXPECT_TRUE(data.flags.data.col(2).all());
+    EXPECT_TRUE(data.scans.data.allFinite());
+}
+
+namespace {
+Eigen::MatrixXd read_matrix(const std::string &path) {
+    std::ifstream f(path); std::string line; std::vector<std::vector<double>> rows;
+    while (std::getline(f,line)) {
+        std::istringstream s(line); double x; std::vector<double> r;
+        while(s>>x) r.push_back(x);
+        if(!r.empty()) rows.push_back(r);
+    }
+    if(rows.empty()) throw std::runtime_error("Missing captured matrix: "+path);
+    Eigen::MatrixXd m(rows.size(),rows.front().size());
+    for(std::size_t i=0;i<rows.size();++i) {
+        if(rows[i].size()!=rows.front().size()) throw std::runtime_error("Ragged matrix");
+        for(std::size_t j=0;j<rows[i].size();++j) m(i,j)=rows[i][j];
+    }
+    return m;
+}
+}
+TEST(Cleaner, CapturedSingleSampleFailureIsFiniteAndSpectraConverges) {
+    auto *path=std::getenv("CITLALI_COVARIANCE_FIXTURE");
+    if(!path) GTEST_SKIP()<<"Set CITLALI_COVARIANCE_FIXTURE to the captured 152434 PCA input";
+    if (!spdlog::get("citlali_logger")) spdlog::stdout_color_mt("citlali_logger");
+    const auto prefix=std::string(path)+"/failed";
+    timestream::TCData<timestream::TCDataKind::PTC,Eigen::MatrixXd> data{};
+    data.scans.data=read_matrix(prefix+"-scans.txt");
+    data.flags.data=read_matrix(prefix+"-flags.txt").cast<bool>();
+    Eigen::MatrixXd apt=read_matrix(prefix+"-apt-flags.txt");
+    ASSERT_EQ((!data.flags.data.col(250).array()).count(),1);
+    timestream::PTCProc proc{}; proc.run_clean=false;
+    engine::Calib calib{}; proc.run(data,data,calib,"altaz","array");
+    auto cov=timestream::masked_covariance(data.scans.data,data.flags.data,apt);
+    EXPECT_TRUE(cov.allFinite()); EXPECT_TRUE(cov.row(250).isZero());
+    timestream::Cleaner cleaner{};
+    auto [values,vectors]=cleaner.calc_eig_values<timestream::Cleaner::SpectraBackend>(data.scans.data,data.flags.data,apt,5);
+    EXPECT_TRUE(values.allFinite()); EXPECT_TRUE(vectors.allFinite());
+    for(int i=0;i<5;++i)
+        EXPECT_LT((cov*vectors.col(i)-values(i)*vectors.col(i)).norm()/values(i),1e-8);
+}
