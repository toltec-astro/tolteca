+/// Physical acceptance rejects finite domain/stability violations. Numerical
+/// acceptance retains those values and diagnostics; hard failures always reject.
+enum class SampleAcceptance { physical, numerical };
+inline std::uint16_t sample_exclusion_mask(SampleAcceptance acceptance) {
+    const auto warnings=condition_high | (acceptance==SampleAcceptance::numerical
+        ? outside_domain | unstable_response : 0);
+    return static_cast<std::uint16_t>(~warnings);
+}
+inline SampleAcceptance parse_sample_acceptance(const std::string &name) {
+    if(name=="physical") return SampleAcceptance::physical;
+    if(name=="numerical") return SampleAcceptance::numerical;
+    throw std::invalid_argument("sample_acceptance must be physical or numerical");
+}
