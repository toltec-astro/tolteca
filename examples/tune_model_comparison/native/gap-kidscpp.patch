+TEST(PhysicalSolver, NumericalAcceptanceRetainsFinitePolicyFailuresAndAllFlags) {
+  ModelParamsTable table; table.channels={17};
+  table.f_in_hz=Eigen::VectorXd::Constant(1,500e6);
+  const double r0=2e-5,b=2*.4*r0*r0*r0;
+  table.model=KidsSweepWithAffineGain::schema(2);
+  table.parameters.resize(1,10);
+  table.parameters<<500e6,500e6,r0,1e-5,2e-6,2.,1.,0.,0.,b;
+  TimeStreamSolver cal(table,table.channels);
+  Matrix I(4,1),Q(4,1),X(4,1),R(4,1),XN(4,1),RN(4,1); Mask flags(4,1),fn(4,1); SolveWorkspace w;
+  const double loss[]{-r0,.4*r0,r0,r0},xp[]{r0,-.4*r0,r0,r0};
+  for(int k=0;k<4;++k) {
+    auto z=std::complex<double>(2.,1.)*(1.-std::complex<double>(1e-5,2e-6)/std::complex<double>(loss[k],xp[k]));
+    if(k==2) z={std::numeric_limits<double>::quiet_NaN(),0.};
+    if(k==3) z={2.,1.};
+    I(k,0)=z.real();Q(k,0)=z.imag();
+  }
+  solve_into(I,Q,cal,1.,X,R,flags,w);
+  solve_into(I,Q,cal,1.,XN,RN,fn,w,SampleAcceptance::numerical);
+  EXPECT_EQ(flags,fn);
+  EXPECT_TRUE(flags(0,0)&outside_domain); EXPECT_TRUE(flags(1,0)&unstable_response);
+  for(int k=0;k<2;++k) { EXPECT_TRUE(std::isnan(X(k,0)));EXPECT_TRUE(std::isfinite(XN(k,0))); EXPECT_NEAR(RN(k,0),loss[k],1e-15); }
+  for(int k=2;k<4;++k) EXPECT_TRUE(std::isnan(XN(k,0)));
+  EXPECT_THROW(parse_sample_acceptance("ignore_everything"),std::invalid_argument);
+}
