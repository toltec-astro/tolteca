+TEST(TimestreamSolver, OmittingJointOutputsPreservesRealChannelResultsAndCalibration) {
+    const auto *path = std::getenv("KIDS_OUTPUT_SCOPE_MANIFEST");
+    if (!path) GTEST_SKIP() << "Set KIDS_OUTPUT_SCOPE_MANIFEST to the all-network comparison input config";
+    const auto config = YAML::LoadFile(path);
+    for (const auto &item : config["inputs"][0]["data_items"]) {
+        if (!item["stubs"]) continue;
+        const auto source = item["filepath"].as<std::string>();
+        SCOPED_TRACE(source);
+        auto raw = kids::toltec::read_raw_timestream_slice(source, {0, 8, 1});
+        kids::TimeStreamSolver solver({{"model_params_nc",source},
+                                      {"stubs",YAML::Dump(item["stubs"])}});
+        const auto all = solver(raw);
+        const auto channels = solver(raw, {{"joint_output",false}});
+        ASSERT_FALSE(all.joint.empty());
+        EXPECT_TRUE(channels.joint.empty());
+        EXPECT_EQ(all.calibration.joint_models.size(), channels.calibration.joint_models.size());
+        EXPECT_EQ(all.calibration.fit_flags, channels.calibration.fit_flags);
+        EXPECT_EQ(all.calibration.channels, channels.calibration.channels);
+        EXPECT_TRUE((all.calibration_flags == channels.calibration_flags).all());
+        EXPECT_EQ(all.flags, channels.flags);
+        for (Eigen::Index j=0;j<all.flags.cols();++j)
+            for (Eigen::Index i=0;i<all.flags.rows();++i) {
+                auto eq=[](double a,double b) {return a==b || (std::isnan(a)&&std::isnan(b));};
+                EXPECT_TRUE(eq(all.data_out.rs.data(i,j),channels.data_out.rs.data(i,j)));
+                EXPECT_TRUE(eq(all.data_out.xs.data(i,j),channels.data_out.xs.data(i,j)));
+                if (all.calibration.fit_flags[j] & kids::reduce::fit_joint_required)
+                    EXPECT_NE(channels.flags(i,j), 0);
+            }
+    }
+}
