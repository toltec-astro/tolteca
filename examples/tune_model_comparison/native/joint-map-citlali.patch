+TEST(JointMapmaking, MixedRealAPTUsesRecordedComponentsAndPreservesScalarControls) {
+  const auto *path=std::getenv("TOLTECA_MIXED_MAP_CONFIG");
+  if (!path) GTEST_SKIP() << "Set TOLTECA_MIXED_MAP_CONFIG to the broader map config";
+  if (!spdlog::get("citlali_logger")) spdlog::stdout_color_mt("citlali_logger");
+  auto config=YAML::LoadFile(path);
+  std::vector<std::string> files, interfaces;
+  for (auto item:config["inputs"][0]["data_items"]) if (item["stubs"] && item["meta"]["interface"].as<std::string>().starts_with("toltec")) {
+    files.push_back(item["filepath"].as<std::string>());
+    interfaces.push_back(item["meta"]["interface"].as<std::string>());
+  }
+  std::string apt;
+  for (auto item:config["inputs"][0]["cal_items"]) if (item["type"].as<std::string>()=="array_prop_table") apt=item["filepath"].as<std::string>();
+  engine::Calib calib{}; calib.get_apt(apt,files,interfaces);
+  for (auto item:config["inputs"][0]["data_items"]) {
+    auto interface=item["meta"]["interface"].as<std::string>();
+    if (!interface.starts_with("toltec")) continue;
+    const int nw=std::stoi(interface.substr(6));
+    auto source=item["filepath"].as<std::string>();
+    auto raw=kids::toltec::read_raw_timestream_slice(source,{0,8,1});
+    kids::TimeStreamSolver solver({{"model_params_nc",source},{"stubs",YAML::Dump(item["stubs"])}});
+    kids::TimeStreamSolver::Config options;
+    engine::select_readout_groups(options,calib,nw);
+    auto result=solver(raw,options);
+    auto scalar=solver(raw,{{"joint_output",false}});
+    auto network=engine::readout_network(calib,nw);
+    ASSERT_EQ(result.joint.size(),network["groups"].size());
+    auto projected=engine::project_kids(result,raw,calib,nw,"xs",kids::reduce::SampleAcceptance::numerical);
+    auto [start,end]=calib.nw_limits.at(nw);
+    auto scalar_calib=calib; scalar_calib.kids_readout.reset(YAML::Node{});
+    auto original=engine::project_kids(scalar,raw,scalar_calib,nw,"xs",kids::reduce::SampleAcceptance::numerical);
+    for (auto binding:network["channel_rows"]) {
+      auto i=binding["apt_row"].as<int>(), channel=binding["channel"].as<int>();
+      for (int s=0;s<8;++s) {
+        EXPECT_EQ(projected.diagnostics.samples.at("kids_sample_flag")(s,i),original.diagnostics.samples.at("kids_sample_flag")(s,channel));
+        if (!projected.mask(s,i)) EXPECT_DOUBLE_EQ(projected.data(s,i),original.data(s,channel));
+      }
+    }
+    for (auto binding:network["rows"]) {
+      auto uid=binding["uid"].as<std::int64_t>();
+      auto i=std::find(calib.detector_uids.begin()+start,calib.detector_uids.begin()+end,uid)-calib.detector_uids.begin()-start;
+      auto gid=binding["group_id"].as<std::string>();
+      auto rid=binding["resonator_id"].as<std::string>();
+      auto it=std::find_if(result.joint.begin(),result.joint.end(),[&](auto &g){return g.calibration.group_id==gid;});
+      ASSERT_NE(it,result.joint.end());
+      auto j=std::find(it->calibration.resonator_ids.begin(),it->calibration.resonator_ids.end(),rid)-it->calibration.resonator_ids.begin();
+      auto k=std::find(it->calibration.channels.begin(),it->calibration.channels.end(),binding["channel"].as<int>())-it->calibration.channels.begin();
+      for(int s=0;s<8;++s) if(!projected.mask(s,i))
+        EXPECT_DOUBLE_EQ(projected.data(s,i),it->x(s,k*it->calibration.resonator_ids.size()+j));
+    }
+    auto stale=calib;
+    stale.kids_readout.reset(YAML::Clone(calib.kids_readout));
+    for (auto net:stale.kids_readout["networks"]) if (net["nw"].as<int>()==nw) net["channel_rows"][0]["uid"]=-9876;
+    EXPECT_THROW(engine::project_kids(result,raw,stale,nw,"xs"),std::runtime_error);
+  }
+}
