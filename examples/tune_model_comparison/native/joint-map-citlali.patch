+/// Request only components declared by the APT; retain complete calibration.
+inline void select_readout_groups(kids::TimeStreamSolver::Config &options,
+                                  const Calib &calib, int nw) {
+  auto network=readout_network(calib,nw);
+  std::set<std::string> ids;
+  if (network.IsMap()) for (const auto &row:network["rows"])
+    ids.insert(row["group_id"].as<std::string>());
+  options.set("joint_output", !ids.empty());
+  if (!ids.empty()) {
+    YAML::Node selected(YAML::NodeType::Sequence);
+    for (const auto &id:ids) selected.push_back(id);
+    options.set("joint_groups", YAML::Dump(selected));
+  }
+}
+
+/// Keep legacy proximity flags on scalar rows within a mixed readout.
+/// Joint components are governed by the complete group's recovery diagnostics.
+inline void set_mixed_tone_flags(Calib &calib, int nw,
+                                 const Eigen::VectorXd &acquired, double minimum) {
+  auto network=readout_network(calib,nw);
+  if (!network.IsMap()) throw std::runtime_error("Mixed tone flags require a readout binding");
+  const auto [start,end]=calib.nw_limits.at(nw);
+  calib.apt["duplicate_tone"].segment(start,end-start).setZero();
+  if (!network["channel_rows"]) return;
+  for(auto row:network["channel_rows"]) {
+    auto local=row["apt_row"].as<Eigen::Index>();
+    auto channel=row["channel"].as<Eigen::Index>();
+    if(local<0 || local>=end-start || channel<0 || channel>=acquired.size() ||
+       calib.detector_uids.at(start+local)!=row["uid"].as<std::int64_t>())
+      throw std::runtime_error("Mixed scalar frequency binding differs from APT/acquisition");
+    auto index=start+local;
+    calib.apt["tone_freq"](index)=acquired(channel);
+    double distance=std::numeric_limits<double>::infinity();
+    if(channel>0) distance=std::min(distance,std::abs(acquired(channel)-acquired(channel-1)));
+    if(channel+1<acquired.size()) distance=std::min(distance,std::abs(acquired(channel+1)-acquired(channel)));
+    calib.apt["duplicate_tone"](index)=distance<minimum;
+  }
 }
 
