+TEST(JointMapmaking, MixedReadoutRetainsScalarProximityVeto) {
+  engine::Calib calib{}; calib.n_dets=3; calib.nw_limits[0]={0,3};
+  calib.detector_uids={10,11,0};
+  calib.apt["tone_freq"]=Eigen::VectorXd::Zero(3);
+  calib.apt["duplicate_tone"]=Eigen::VectorXd::Zero(3);
+  calib.kids_readout=YAML::Load(R"(
+networks:
+- nw: 0
+  rows: [{uid: 11, group_id: g, resonator_id: b, channel: 1}]
+  channel_rows: [{apt_row: 0, uid: 10, channel: 0}, {apt_row: 2, uid: 0, channel: 2}]
+)");
+  Eigen::VectorXd probes(3);probes<<500e6,500.01e6,501e6;
+  engine::set_mixed_tone_flags(calib,0,probes,60e3);
+  EXPECT_EQ(calib.apt["duplicate_tone"](0),1);
+  EXPECT_EQ(calib.apt["duplicate_tone"](1),0);
+  EXPECT_EQ(calib.apt["duplicate_tone"](2),0);
+  EXPECT_EQ(calib.apt["tone_freq"](0),probes(0));
+  EXPECT_EQ(calib.apt["tone_freq"](2),probes(2));
+}
